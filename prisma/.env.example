# Database Configuration
# =======================

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:password@localhost:5432/priacc_crm_dev?schema=public"

# Example for production
# DATABASE_URL="postgresql://user:password@prod-host:5432/priacc_crm_prod?schema=public"

# Example for Railway/Render
# DATABASE_URL="postgresql://user:password@host.railway.app:5432/railway?schema=public"

# Example for Supabase
# DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres?schema=public"

# Example for Neon
# DATABASE_URL="postgresql://user:password@ep-cool-cloud-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Notes:
# ------
# 1. Copy this file to .env and update with your actual database credentials
# 2. Never commit .env file to version control
# 3. Ensure PostgreSQL is running before running migrations or seeds
# 4. Default PostgreSQL port is 5432
# 5. Schema is typically 'public' for PostgreSQL
